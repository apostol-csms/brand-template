# Nuxt landing runtime env — rendered into ../landing/src/.env by
# hooks/pre-install.sh via envsubst + workdir/.env.
#
# Placeholders resolve from the merged workdir/.env (root .env.template
# + envs/<env>/.env.template + secrets). Keep this whitelist in sync
# with the envsubst argument in hooks/pre-install.sh.

NUXT_PUBLIC_GTM_ID=${NUXT_PUBLIC_GTM_ID}

NUXT_SMTP_HOST=${NUXT_SMTP_HOST}
NUXT_SMTP_PORT=${NUXT_SMTP_PORT}
NUXT_SMTP_USER=${NUXT_SMTP_USER}
NUXT_SMTP_PASS=${NUXT_SMTP_PASS}
NUXT_SMTP_TO=${NUXT_SMTP_TO}

NODE_ENV=production
PORT=3000

-- Deployment-specific keys. Rendered via envsubst.
-- Source of truth: this template + workdir/.env.
--
-- ЭТО НАДМНОЖЕСТВО — обрежьте под свой рынок. Здесь перечислены ключи
-- обоих платёжных провайдеров сразу (ЮKassa и Stripe), потому что шаблон
-- обслуживает и российские, и европейские бренды. Живой бренд оставляет
-- строки только своего провайдера: незаполненные set_config кладут в GUC
-- пустую строку, и отличить «провайдер не настроен» от «ключ потеряли»
-- потом невозможно.
--
-- map.api_key — ОДНА переменная на активного провайдера. Она должна
-- соответствовать MAP_PROVIDER в envs/<env>/.env.template: yandex →
-- YANDEX_MAPS_API_KEY, google → GOOGLE_MAPS_API_KEY, stadia →
-- STADIA_API_KEY. Рассогласование не ломает установку — карта просто
-- не рисуется, и причина ищется долго.
--
-- NOTE (platform tech-debt): set_config(..., false) is SESSION-local.
-- These GUCs only live inside the psql session that runs install.sh /
-- migrate.sh. Backend/ocpp (separate sessions) don't see them. For
-- persistence the platform should switch to ALTER DATABASE SET —
-- tracked for apostol-csms/db.

-- Deployment type (overrides .env.psql default)
SELECT set_config('project.deployment', '${BUILD_ENV}', false);

SELECT set_config('yookassa.shop.id', '${YOOKASSA_SHOP_ID}', false);
SELECT set_config('yookassa.shop.key', '${YOOKASSA_SHOP_KEY}', false);

SELECT set_config('yookassa.oauth.client_id', '${YOOKASSA_OAUTH_CLIENT_ID}', false);
SELECT set_config('yookassa.oauth.client_secret', '${YOOKASSA_OAUTH_CLIENT_SECRET}', false);

-- Map provider for frontends. The api_key is the active providers
-- public, referrer-restricted key (Yandex Maps for the RU market).
SELECT set_config('map.provider',       '${MAP_PROVIDER}', false);
SELECT set_config('map.api_key',        '${YANDEX_MAPS_API_KEY}', false);
SELECT set_config('map.default_center', '${MAP_DEFAULT_CENTER}', false);

-- Stripe keys:
SELECT set_config('stripe.secret_key', '${STRIPE_SECRET_KEY}', false);
SELECT set_config('stripe.publishable_key', '${STRIPE_PUBLISHABLE_KEY}', false);
SELECT set_config('stripe.webhook_secret', '${STRIPE_WEBHOOK_SECRET}', false);

-- OAuth2 client secrets:
SELECT set_config('secret.service', '${OAUTH2_SECRET_SERVICE}', false);
SELECT set_config('secret.web', '${OAUTH2_SECRET_WEB}', false);
SELECT set_config('secret.android', '${OAUTH2_SECRET_ANDROID}', false);
SELECT set_config('secret.ios', '${OAUTH2_SECRET_IOS}', false);
SELECT set_config('secret.ocpp', '${OAUTH2_SECRET_OCPP}', false);

-- Google OAuth2:
SELECT set_config('google.code', '${GOOGLE_CLIENT_ID}', false);
SELECT set_config('google.secret', '${GOOGLE_CLIENT_SECRET}', false);

-- Current key:
SELECT set_config('current.key', '${CURRENT_KEY}', false);

-- Auth channel config (manifest.auth.{webapp,driver}). Email-only — no SMS
-- gateway in this brand. Validated by UpdateManifest() — phone channel
-- requires brand.sms_address.
SELECT set_config('auth.webapp.primary',  '${AUTH_WEBAPP_PRIMARY}', false);
SELECT set_config('auth.webapp.channels', '${AUTH_WEBAPP_CHANNELS}', false);
SELECT set_config('auth.driver.primary',  '${AUTH_DRIVER_PRIMARY}', false);
SELECT set_config('auth.driver.channels', '${AUTH_DRIVER_CHANNELS}', false);

-- Branding tokens for the root tenant (SaaS owner).
-- Rendered via envsubst from workdir/.env (BRANDING_*).
-- Used by FillDataBase to populate tenant.metadata.branding.
-- Frontend reads via whoami → tenant.metadata.branding.light/dark.

-- Company info
SELECT set_config('branding.company_name', :'company', false);
-- Served by every frontend from /public/brand-defaults/ (webapp, driver, pay,
-- landing, auth). Paths are identical across apps, so one metadata value
-- covers them all. See brand/README.md.
SELECT set_config('branding.mark', '${BRANDING_MARK}', false);
SELECT set_config('branding.logo_url', '${BRANDING_LOGO_URL}', false);
SELECT set_config('branding.logo_dark_url', '${BRANDING_LOGO_DARK_URL}', false);
SELECT set_config('branding.favicon_url', '${BRANDING_FAVICON_URL}', false);
SELECT set_config('branding.support_email', '${BRANDING_SUPPORT_EMAIL}', false);


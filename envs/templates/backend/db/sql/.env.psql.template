-- Docker environment: passwords and project settings.
-- Rendered into workdir/db/sql/.env.psql by envs/<env>/render.sh via envsubst.
-- Source of truth: this template + workdir/.env (merged).

-- PostgreSQL user passwords:
\set kernel '${DB_PASS_KERNEL}'
\set admin '${DB_PASS_ADMIN}'
\set daemon '${DB_PASS_DAEMON}'
\set apibot '${DB_PASS_APIBOT}'
\set mailbot '${DB_PASS_MAILBOT}'
\set ocpp '${DB_PASS_OCPP}'
\set ocpi '${DB_PASS_OCPI}'
\set http '${DB_PASS_HTTP}'
\set cpo '${DB_PASS_CPO}'
\set driver '${DB_PASS_DRIVER}'
\set demo 'demo'

\set username kernel

SELECT set_config('password.kernel', :'kernel', false);
SELECT set_config('password.admin', :'admin', false);
SELECT set_config('password.daemon', :'daemon', false);
SELECT set_config('password.apibot', :'apibot', false);
SELECT set_config('password.mailbot', :'mailbot', false);
SELECT set_config('password.cpo', :'cpo', false);
SELECT set_config('password.driver', :'driver', false);
SELECT set_config('password.demo', :'demo', false);

\set company '${PROJECT_DISPLAY_NAME}'

-- Project settings:
SELECT set_config('project.id', '${PROJECT_ID}', false);
SELECT set_config('project.code', '${PROJECT_CODE}', false);
SELECT set_config('project.name', :'company', false);
SELECT set_config('project.domain', '${DOMAIN}', false);
SELECT set_config('project.url', '${PROJECT_URL}', false);
SELECT set_config('project.scope_alias', '${PROJECT_SCOPE_ALIAS}', false);
SELECT set_config('project.locale', '${PROJECT_LOCALE}', false);
SELECT set_config('project.currency', '${PROJECT_CURRENCY}', false);
SELECT set_config('project.country_code', '${PROJECT_COUNTRY_CODE}', false);
SELECT set_config('project.party_id', '${PROJECT_PARTY_ID}', false);
SELECT set_config('project.payment_system', '${PROJECT_PAYMENT_SYSTEM}', false);
SELECT set_config('project.sms.address', '${PROJECT_SMS_ADDRESS}', false);
SELECT set_config('project.description', '${PROJECT_DESCRIPTION}', false);

-- OCPP CS address (Docker service name, not localhost):
SELECT set_config('project.ocpp.api', '${PROJECT_OCPP_API}', false);

-- AI Service:
SELECT set_config('ai_service.provider', '${LLM_PROVIDER}', false);
SELECT set_config('ai_service.model', '${AI_DEFAULT_MODEL}', false);

\ir .env.key.psql
\ir .env.branding.psql

# envs/prod/.env.template
# Per-environment overrides for the `prod` deployment. Merged over the
# root .env.template by install.sh/update.sh.

BUILD_ENV=prod
DOMAIN=example.com

PROJECT_DISPLAY_NAME="Apostol CSMS"
PROJECT_URL=https://cloud.example.com
PROJECT_SCOPE_ALIAS=https://cloud.example.com
# ── Market identity (required — install.sh refuses to run while blank) ──
# No safe default exists for these: the root .env.template used to default
# currency to USD, and a brand that forgot the key here installed cleanly in
# the wrong denomination. They are snapshotted into the DB at install and
# nothing re-syncs them afterwards, so getting them wrong costs a reinstall.
PROJECT_CURRENCY=
PROJECT_COUNTRY_CODE=
PROJECT_PAYMENT_SYSTEM=


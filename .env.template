# ═══════════════════════════════════════════════════════════════════════════
#  Apostol CSMS — brand deployment env (schema v2 / 2026-04-28 license rework)
# ═══════════════════════════════════════════════════════════════════════════
#
# Reference template. Merged by install.sh / update.sh with:
#   1. envs/<env>/.env.template            (per-env overrides + brand identity)
#   2. .secrets/<env>.env via load-from-vault.sh   (passwords, API keys)
# Result lands in workdir/.env (chmod 600, gitignored).
#
# CHANGE_ME markers — install.sh refuses if any survive in workdir/.env.
# Empty values are usually OK (feature gated off until populated).
#
# What does NOT live here (since 2026-04-28 license rework):
#   • Brand identity (code, name, legal_name, tax_id, email, domain) — in
#     conf/license.json, signed by platform.
#   • Brand runtime config (theme tokens, OAuth client_id, payment publish-
#     able, map provider/keys, locale, party_id) — in db.brand_manifest,
#     served via /api/v1/manifest.
#   • Frontend public mirrors (NEXT_PUBLIC_*_API_KEY, NEXT_PUBLIC_*_PROVIDER)
#     — secrets-loader.sh auto-mirrors them from the source vars below.
#
#                ┌─────────────────────────────────────────────┐
#                │  GROUPING — by lifecycle phase              │
#                ├─────────────────────────────────────────────┤
#                │  Section 1: INSTALL (consumed once at       │
#                │             db-init/migrate, frozen in DB)  │
#                │  Section 2: RUNTIME (read by services on    │
#                │             start / per-request)            │
#                └─────────────────────────────────────────────┘

# ╔═══════════════════════════════════════════════════════════════════════════
# ║                             SECTION 1 — INSTALL
# ║
# ║  These values feed db/docker/compose-env.sh, which composes the install-
# ║  time .env.psql. The SQL runs once, persists results into db.client,
# ║  db.audience, db.registry, db.brand_manifest, pg_authid. After first
# ║  install, runtime services read from the DB, not from these vars.
# ║  Changing these post-install only affects fresh re-installs (--force)
# ║  or migrations that re-read the GUCs.
# ╚═══════════════════════════════════════════════════════════════════════════

# ─── [I-1] DB user passwords ─────────────────────────────────────────
# Set in pg_authid on first install. pgbouncer no longer keeps a copy:
# it authenticates through auth_query and holds only DB_PASS_PGBOUNCER
# in its userlist. In image mode entrypoint-secrets.sh auto-generates
# these inside csms-secrets/passwords.psql if absent — override here
# only for source-clone dev or scheduled rotation.

POSTGRES_PASSWORD=CHANGE_ME

DB_PASS_KERNEL=CHANGE_ME
DB_PASS_ADMIN=CHANGE_ME
DB_PASS_DAEMON=CHANGE_ME
DB_PASS_APIBOT=CHANGE_ME
DB_PASS_MAILBOT=CHANGE_ME
DB_PASS_OCPP=CHANGE_ME
DB_PASS_OCPI=CHANGE_ME
DB_PASS_HTTP=CHANGE_ME
DB_PASS_CPO=CHANGE_ME
DB_PASS_DRIVER=CHANGE_ME

# ─── [I-2] OAuth2 HS256 client secrets ───────────────────────────────
# Seeded into db.audience at install. Backend reads from db.audience at
# runtime, not from these env vars. Same auto-generation rules as DB_PASS_*.

OAUTH2_SECRET_SERVICE=CHANGE_ME
OAUTH2_SECRET_WEB=CHANGE_ME
OAUTH2_SECRET_ANDROID=CHANGE_ME
OAUTH2_SECRET_IOS=CHANGE_ME
OAUTH2_SECRET_OCPP=CHANGE_ME

# ─── [I-3] Project deployment defaults (PROJECT_*) ───────────────────
# Seeded into db.client / db.brand_manifest at install (project.* GUCs).
# Brand identity (code, name, etc.) comes from license.json — operator-
# managed values here cover currency, locale, party_id, payment_system.
#
# PROJECT_CURRENCY, PROJECT_COUNTRY_CODE and PROJECT_PAYMENT_SYSTEM are
# deliberately EMPTY here and must be pinned in envs/<env>/.env.template.
# install.sh refuses to proceed while any of the three is blank.
#
# PROJECT_CURRENCY used to default to USD. That default is what a market
# value must never have: install.sh merges this file first, so a brand whose
# per-env template forgot the key inherited USD and installed cleanly.
# ChargeMeCar's stage ran that way — registry Currency=USD on a EUR brand,
# 29 accounts and every price row denominated in USD, plus a fleet per-kWh
# rate two orders of magnitude off — and nothing failed, because a plausible
# wrong answer looks exactly like a right one. Empty + a hard check fails
# loudly on the first install instead.

PROJECT_ID=
PROJECT_CODE=
PROJECT_DISPLAY_NAME=
PROJECT_DESCRIPTION=
PROJECT_URL=
PROJECT_SCOPE_ALIAS=
PROJECT_LOCALE=en
PROJECT_CURRENCY=
PROJECT_COUNTRY_CODE=
PROJECT_PARTY_ID=
PROJECT_PAYMENT_SYSTEM=
PROJECT_SMS_ADDRESS=
PROJECT_OCPP_API=http://ocpp:9220

# Meter sanity guard (CONFIG\Service\Session / MeterGuard).
#   1 - CheckTransactionMeter refuses to bill energy whose implied power
#       exceeds the connector rating (voltage x current x phases, x1.5). A
#       station replaying an un-reset counter bills nobody for kilowatt-hours
#       it never delivered; the session is logged instead.
#   0 - off. Belongs to deployments that run station emulators: CPEmulator
#       does not tie the energy it reports to any connector rating, so every
#       emulated session would be flagged and left unbilled.
# Unlike most of section 1 this one is re-read on every --update
# (transaction/update.psql), so flipping it here reaches a running deployment.
PROJECT_METER_GUARD=1

# ─── [I-4] Legal entity extras (jurisdiction-specific) ───────────────
# company.{name,description,email,tax_id} come from the licence;
# these fields cover RU/EU jurisdiction extras the licence does not carry.
# Seeded into db.tenant at install.

COMPANY_CODE=
COMPANY_OGRN=
COMPANY_KPP=
COMPANY_ADDRESS=
COMPANY_ACCOUNT=
COMPANY_ACCOUNT_ISSUED=
COMPANY_COR_ACCOUNT=
COMPANY_BIC=

# ─── [I-5] Per-deployment AES seed ───────────────────────────────────
# Set once in registry at install. Generate per-brand: openssl rand -hex 32.
# Lives in .secrets/<env>.env, propagated via loader OPTIONAL.

CURRENT_KEY=

# ─── [I-6] Branding seed (db.brand_manifest initial row) ─────────────
# Frontend reads via /api/v1/manifest at runtime — these stay empty for a
# license-driven theme. Filled values seed the initial manifest row; admin
# UI overrides them post-install via PATCH /api/v1/manifest.

# The SQUARE brand mark. logo_url is a wordmark; an app icon and a favicon
# cannot use a 180x40 strip, so the PWA manifest and the tab icon read this
# instead. A URL or a data: URI — the artwork usually lives in the brand's
# landing repo, which the driver container never sees, and an inline SVG
# under ~1 KB travels inside the signed manifest with nothing to host.
# Empty falls back to the platform's own neutral mark.
#
# ⚠️ The value is NOT quoted here and may contain a semicolon freely —
# `data:image/svg+xml;base64,…` is the normal shape. That is safe because
# workdir/.env is no longer executed: envs/<env>/render.sh parses it line
# by line. If you ever touch render.sh, do not put `source` back — this
# file holds every database role password and the OAuth2 secrets, and a
# `;` inside a value splits the line into two commands and kills the
# install with exit 127.
#
# ⚠️ And do not leave another brand's artwork here. This is what EVERY
# brand falls back to; a mark forgotten in the template ships with every
# new deployment.
BRANDING_MARK=
BRANDING_LOGO_URL=
BRANDING_LOGO_DARK_URL=
BRANDING_FAVICON_URL=
BRANDING_SUPPORT_EMAIL=

# Light theme (22 tokens). Empty values are dropped by GetManifestSeed.
BRANDING_LIGHT_PRIMARY_COLOR=
BRANDING_LIGHT_ACCENT_COLOR=
BRANDING_LIGHT_SUCCESS_COLOR=
BRANDING_LIGHT_DANGER_COLOR=
BRANDING_LIGHT_WARNING_COLOR=
BRANDING_LIGHT_INFO_COLOR=
BRANDING_LIGHT_BG_COLOR=
BRANDING_LIGHT_BG_ALT_COLOR=
BRANDING_LIGHT_BG_MUTED_COLOR=
BRANDING_LIGHT_SURFACE_COLOR=
BRANDING_LIGHT_TEXT_COLOR=
BRANDING_LIGHT_TEXT_MUTED_COLOR=
BRANDING_LIGHT_BORDER_COLOR=
BRANDING_LIGHT_BORDER_STRONG_COLOR=
BRANDING_LIGHT_BORDER_TABLE_COLOR=
BRANDING_LIGHT_SIDEBAR_COLOR=
BRANDING_LIGHT_SIDEBAR_LOGO_COLOR=
BRANDING_LIGHT_SUCCESS_BG_COLOR=
BRANDING_LIGHT_SUCCESS_BORDER_COLOR=
BRANDING_LIGHT_DANGER_BG_COLOR=
BRANDING_LIGHT_DANGER_BORDER_COLOR=
BRANDING_LIGHT_WARNING_BG_COLOR=

# Dark theme (22 tokens).
BRANDING_DARK_PRIMARY_COLOR=
BRANDING_DARK_ACCENT_COLOR=
BRANDING_DARK_SUCCESS_COLOR=
BRANDING_DARK_DANGER_COLOR=
BRANDING_DARK_WARNING_COLOR=
BRANDING_DARK_INFO_COLOR=
BRANDING_DARK_BG_COLOR=
BRANDING_DARK_BG_ALT_COLOR=
BRANDING_DARK_BG_MUTED_COLOR=
BRANDING_DARK_SURFACE_COLOR=
BRANDING_DARK_TEXT_COLOR=
BRANDING_DARK_TEXT_MUTED_COLOR=
BRANDING_DARK_BORDER_COLOR=
BRANDING_DARK_BORDER_STRONG_COLOR=
BRANDING_DARK_BORDER_TABLE_COLOR=
BRANDING_DARK_SIDEBAR_COLOR=
BRANDING_DARK_SIDEBAR_LOGO_COLOR=
BRANDING_DARK_SUCCESS_BG_COLOR=
BRANDING_DARK_SUCCESS_BORDER_COLOR=
BRANDING_DARK_DANGER_BG_COLOR=
BRANDING_DARK_DANGER_BORDER_COLOR=
BRANDING_DARK_WARNING_BG_COLOR=

# ─── [I-7] Auth channels (db.brand_manifest.auth.*) ──────────────────
# Seeded into manifest at install via compose-env.sh:emit_auth_app().
# Empty pair → app block omitted, frontend useAuthChannels falls back to
# DEFAULT_CONFIG (email-only). UpdateManifest() requires brand.sms_address
# in the licence whenever 'phone' appears in channels.

AUTH_WEBAPP_PRIMARY=
AUTH_WEBAPP_CHANNELS=
AUTH_DRIVER_PRIMARY=
AUTH_DRIVER_CHANNELS=

# ─── [I-8] Map provider seed ─────────────────────────────────────────
# MAP_PROVIDER picks which SDK frontends bundle (google / yandex / stadia).
# compose-env.sh resolves the matching <PROVIDER>_MAPS_API_KEY (or
# STADIA_API_KEY) into manifest.map.api_key — only the active provider's
# key ships to clients. MAP_DEFAULT_CENTER format: "lng,lat" (GeoJSON).

MAP_PROVIDER=
MAP_DEFAULT_CENTER=

GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
STADIA_API_KEY=

# ─── [I-9] Payment providers (server-side secrets) ───────────────────
# All seeded into db.audience / db.registry at install. Backend reads
# from the DB at runtime. Publishable keys also flow into manifest.

# Stripe — server side
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# YooKassa — server side
YOOKASSA_SHOP_ID=
YOOKASSA_SHOP_KEY=
# Partners API OAuth (multi-tenant brands). client_id public, secret in vault.
YOOKASSA_OAUTH_CLIENT_ID=
YOOKASSA_OAUTH_CLIENT_SECRET=

# ─── [I-10] Google OAuth2 (server-side) ──────────────────────────────
# For "Login with Google". Seeded into db.audience. Public client_id also
# mirrored into manifest.google.client_id.

GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ╔═══════════════════════════════════════════════════════════════════════════
# ║                             SECTION 2 — RUNTIME
# ║
# ║  These values are read by services on every container start or per
# ║  request — they are NOT seeded into the DB. Changing them and running
# ║  ./update.sh takes effect on the next container boot.
# ╚═══════════════════════════════════════════════════════════════════════════

# ─── [R-0] Image registry ────────────────────────────────────────────
#
# Defaults are the platform's public contour: csms-* images from GHCR,
# base images from Docker Hub. A brand mirroring the images into its own
# registry (for data-residency requirements, say) overrides these four
# variables in envs/<env>/.env.template.
#
# REGISTRY is substituted whole, organisation included:
#   REGISTRY=registry.example.ru      → registry.example.ru/csms-backend
#   (default)                         → ghcr.io/apostol-csms/csms-backend
#
# If the registry needs authentication, REGISTRY_USER and REGISTRY_PASS
# go into .secrets/<env>.env (NOT here) and install.sh / update.sh run
# docker login before compose pull. Empty values mean no login.
#
# BASE_REGISTRY addresses the build base images (postgres, nginx). The
# two floating upstream tags are separate variables: a mirroring brand
# pins them by date, otherwise `latest` stays a moving target.
REGISTRY=ghcr.io/apostol-csms
BASE_REGISTRY=docker.io/library
PGBOUNCER_IMAGE=edoburu/pgbouncer:latest
PGWEB_IMAGE=sosedoff/pgweb:latest

# ─── [R-1] Platform pinning ──────────────────────────────────────────
# Must match an apostol-csms/* git tag (vX.Y.Z) and a pushed GHCR image
# (ghcr.io/apostol-csms/csms-backend:X.Y.Z). Canonical source is
# envs/<env>/platform.lock.json — install.sh re-exports PLATFORM_VERSION
# from there and asserts it matches.
PLATFORM_VERSION=

# Build environment label: dev | stage | prod. Selects envs/<env>/* dir
# and propagates into compose-env.sh's project.deployment GUC.
BUILD_ENV=

# Compose project name — prefixes networks (<name>_lan-network, …) and
# named volumes. Should match the brand code; container names are explicit
# in docker-compose.yaml (container_name:) so DNS is unaffected.
PROJECT_NAME=

# ─── [R-2] Application database ──────────────────────────────────────
# postgres image bootstraps the cluster using POSTGRES_PASSWORD on the
# first run only — subsequent restarts read from pg_authid. PGDATABASE is
# read on every start by both postgres and backend.

PGDATABASE=csms

# ─── [R-2a] PostgreSQL capacity profile ──────────────────────────────
# Passed to the vanilla postgres:18 image as -c flags by docker-compose.
# The values below are the SMALL profile — sized for a 2 vCPU / 3–4 GB
# host, which is what a first brand deployment usually gets.
#
# Override the whole block in envs/<env>/.env.template when the host is
# bigger; leaving these defaults on a large machine wastes it entirely
# (a 62 GB server was running with 512 MB of shared_buffers because this
# block used to be hard-coded in docker-compose.yaml).
#
# Reference points measured 2026-08-07, see
# docs/plans/backend/2026-08-07-ocpp-throughput-ceiling.md:
#   small   2 vCPU /  3 GB   →  values below
#   medium  4 vCPU /  7 GB   →  1536MB / 4GB / 384MB / 4MB, 4 workers
#   large  20 vCPU / 62 GB   →  12GB / 40GB / 2GB / 16MB, 20 workers
#
# max_connections: the backend pool holds ~64 apibot + ~31 daemon slots
# permanently; 200 leaves room for kernel (db-migrate) and admin queries.

PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_WAL_BUFFERS=16MB
PG_WORK_MEM=1310kB
PG_MIN_WAL_SIZE=1GB
PG_MAX_WAL_SIZE=4GB
PG_MAX_WORKER_PROCESSES=2
PG_MAX_PARALLEL_WORKERS=2
PG_MAX_PARALLEL_WORKERS_PER_GATHER=1

# ─── [R-3] Domain & frontend wiring ──────────────────────────────────
# nginx / certbot / landing / SPAs all consume DOMAIN on every start.
# ALT_DOMAIN — optional second apex (Host-header locale routing).

DOMAIN=example.com
ALT_DOMAIN=

# Frontend ↔ backend wiring (Dockerfile ARG → ENV → bundle bake-in).
# Empty API_HOST / WS_HOST → webapp uses window.location.origin.
API_HOST=
WS_HOST=
API_VERSION=/api/v1

NEXT_PUBLIC_API_HOST=
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_WS_HOST=
NEXT_PUBLIC_NOMINATIM_URL=

NUXT_API_HOST=http://backend:4977
NUXT_PUBLIC_API_HOST=
NUXT_PUBLIC_GTM_ID=

# ─── [R-4] SMTP — backend ────────────────────────────────────────────
# backend/conf/default.json substitutes $SMTP_HOST / $SMTP_PORT etc. via
# its own envsubst-equivalent on startup. Each mailbox (info/noreply/
# support) shares the same host but has its own login.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME_INFO=info@example.com
SMTP_PASSWORD_INFO=CHANGE_ME
SMTP_USERNAME_NOREPLY=noreply@example.com
SMTP_PASSWORD_NOREPLY=CHANGE_ME
SMTP_USERNAME_SUPPORT=support@example.com
SMTP_PASSWORD_SUPPORT=CHANGE_ME

# ─── [R-5] SMTP — pay / landing (Nuxt SSR) ───────────────────────────
# Separate SMTP route for outgoing pay-receipt and landing-contact emails.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=noreply@example.com
NUXT_SMTP_PASS=CHANGE_ME
NUXT_SMTP_TO=info@example.com

# ─── [R-6] Backend tunables ──────────────────────────────────────────

WORKER_PROCESSES=8

# ─── [R-7] AI support agent ──────────────────────────────────────────
# The `ai-service` container and the `ai/` database module. The container
# is part of the default stack — it used to sit behind a compose profile,
# which was right only while ghcr.io/apostol-csms/csms-ai-service did not
# exist yet and turning the profile on failed the pull. The image ships
# with the platform now, so the switch bought nothing but a CONFIG\AI
# ServiceURL pointing at a host nobody started.
#
# What stays per-brand is the settings below: which provider answers, and
# whether a key is present at all.
#
# Keys are NOT set here — they are secrets and belong in
# envs/<env>/secrets/load-from-vault.sh. Leaving them blank is fine; the
# service starts and reports the missing credential in the driver's chat
# instead of crashing.
#
# Which provider is a MARKET decision, not a platform one. A brand
# operating in Russia should run yandex or gigachat: OpenAI answers 403
# unsupported_country_region_territory from a Russian address, and a
# dependency on a foreign LLM is a blocker in its own right for the
# national software registry filing. A proxy works around the first
# problem while making the second one worse.

# openai | perplexity | anthropic | yandex | gigachat
LLM_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5.6-terra

# Where uvicorn binds INSIDE the container. 0.0.0.0 is right on the lan
# network. Set 127.0.0.1 only for a host-network deployment sitting behind
# nginx, where listening on all interfaces would publish the service.
AI_HOST=0.0.0.0
AI_PORT=8000

# Where the service reaches OUR REST API to call tools with the driver's
# token. Inside the lan network the default is right; override only when
# the service runs outside the stack.
AI_API_URL=http://backend:4977
# Other environments allowed to call in with their own api_url, comma
# separated. A driver's token is only valid in the database it came from,
# so anything outside this list is refused.
AI_ALLOWED_API_URLS=

# Shared secret (X-AI-Key). Empty = no check, which is correct while the
# service is lan-only. Set it in the vault when publishing through nginx.
AI_SERVICE_KEY=

# Proxy for the LLM client, and only for it — calls to our own REST are
# built with trust_env=False and ignore the environment. Carries
# credentials when set, so it belongs in the vault, not here.
#
# The variable says http; the effect covers https too (httpx maps a bare
# proxy onto `all://` and tunnels via CONNECT). One value is enough.
#
# WHO NEEDS IT: a deployment whose egress cannot reach a FOREIGN provider
# directly. That is the Russian brands while they run openai/anthropic —
# without it every call comes back 403
# unsupported_country_region_territory. Nobody needs it for yandex or
# gigachat, and leaving it set after a switch sends Russian traffic abroad
# for nothing; /health warns about exactly that.
AI_HTTP_PROXY=

# Turn this on wherever the proxy is REQUIRED rather than optional. The
# service cannot work it out for itself: from inside the container a
# blocked egress looks like a healthy network until the first 403. With it
# on, a missing AI_HTTP_PROXY is reported by /health as a missing
# credential, the same way a missing key is — instead of a service that
# claims to be configured and answers nothing.
AI_REQUIRE_PROXY=false
AI_NO_PROXY=localhost,127.0.0.1,backend,ocpp,ai-service,postgres,pgbouncer

# Self-hosted OpenAI-compatible endpoint (vLLM, Ollama, a gateway).
AI_LLM_BASE_URL=

# Action limiters. They live in the service's code, not in the prompt.
AI_ACTION_RATE_LIMIT=5
AI_ACTION_DEBOUNCE_SECONDS=5
AI_LOG_LEVEL=info

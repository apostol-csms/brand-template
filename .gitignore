# Gitignored paths — DO NOT commit.
#
# ⚠️ This file was missing from the template for a long time. A brand
# cloned without it commits workdir/ — which holds the merged .env with
# EVERY database role password, the OAuth2 secrets and the payment
# provider keys. Plus .secrets/, conf/license.json and credential.helper.
# Do not remove it.

# install.sh creates this; contains merged .env with secrets + cloned
# platform sources. The whole tree is stateful and host-specific.
workdir/

# Never commit secrets, even if someone mis-locates them inside the
# brand repo. The real location is one level up, OUTSIDE this repo:
#   brands/<brand>/.secrets/<env>.env
.secrets/
*.secrets.env
.env
.env.*.local

# Exception: postgres bootstrap .env contains no secrets
# (POSTGRES_DB/USER/INITDB_ARGS only; superuser password comes from
# compose env_file ./workdir/.env).
!.docker/postgres/.env

# Packaging artifacts (created by brands/<brand>.sh)
*.tgz

# One-off credential-helper snippet (may contain a GitHub PAT in
# plaintext — kept out of git and out of shipped tarballs).
credential.helper

# Runtime conf/ staging dir — populated by hooks/pre-install.sh from
# .secrets/ (license.json, landing.env, and any dated .bak-* snapshots
# left behind by re-runs). Per-deployment, never committed.
conf/

# Per-release CSMS_DB_KEY (Phase 4c — wraps into license.json db_key_wrapped).
.csms_db_key

# WireGuard identity — per-deployment. Generated locally if the `vpn`
# profile is enabled. Committing would share VPN identity across brands.
.docker/wireguard/server/privatekey
.docker/wireguard/server/publickey
.docker/wireguard/peers/*/privatekey
.docker/wireguard/peers/*/publickey

# Editor / OS
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Real SCRAM hashes regenerated by hooks/post-install.sh from pg_authid.
# The committed file is a placeholder; never overwrite it with the
# real hashes from pgbouncer container or workdir/pgbouncer/.
.docker/pgbouncer/userlist.txt

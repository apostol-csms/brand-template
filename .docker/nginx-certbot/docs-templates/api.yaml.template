                      type: string
                      format: uuid
                    client:
                      type: string
                      format: uuid
                    code:
                      type: string
                    currency:
                      type: string
                      format: uuid
                    description:
                      type: string
                    id:
                      type: string
                      format: uuid
                    label:
                      type: string
                    parent:
                      type: string
                      format: uuid
                    type:
                      type: string
                      format: uuid

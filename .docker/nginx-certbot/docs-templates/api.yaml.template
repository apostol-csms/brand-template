openapi: 3.0.3
info:
  title: CSMS REST API
  version: '1.0'
  description: 'REST API of the charging-station management system, as served at `/api/v1` of the host
    this page is opened on.


    Almost every operation is a POST with a JSON body; the few GET routes are marked as such. Authentication
    is OAuth 2.0 (authorization code, or password for a client of your own) with a bearer access token;
    browser sessions use HttpOnly cookies. To try a call, paste an access token into Authorize (bearerAuth).'
servers:
- url: /api/v1
  description: This installation
security:
- oauth2:
  - ${OAUTH_SCOPE}
- bearerAuth: []
- cookieAuth: []

          description: There is no such service, or the caller may not see it — the two are not told apart.
        default:
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'Any other refusal of the error catalogue: the status is the GGG of its ERR-GGG-CCC
            code (400 where that is not a status). A failure of the service itself is 500 with type urn:apostol:error:internal.'
      summary: Get a service
      tags:
      - services
    patch:
      description: 'Only the given keys change. If-Match is required: the ETag of the revision the client
        read.


        Route guard: the gateway refuses this write to every session that is not an administrator (403),
        before the database; the routes that read are open to any session.'
      operationId: services_update
      parameters:
      - description: 'Identifier of the service: a UUID. Anything else is refused with 400 before the
          database.'
        in: path
        name: id
        required: true
        schema:
          format: uuid
          type: string
      - description: The ETag of the row as read; * matches any current row. Without it the answer is
          428 and the body is not read.
        in: header
        name: If-Match
        required: true
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ServicePatch'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Service'
          description: The row after the change.
          headers:
            ETag:

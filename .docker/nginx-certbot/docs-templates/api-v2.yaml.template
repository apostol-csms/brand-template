              schema:
                type: string
        '400':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: The id is not a UUID, the body is empty or has no key, an unknown key, a value
            of the wrong type or one the database refuses.
        '401':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No bearer token, a token that does not verify or has expired, or a session the
            database does not know. Carries WWW-Authenticate.
        '403':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'The database refused: the route is not open to this session, or a right is missing
            (ERR-403-…).'
        '404':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: There is no such service, or the caller may not see it — the two are not told apart.
        '412':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'The row changed since it was read: If-Match is no longer its ETag.'
        '428':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No If-Match header.
        default:
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'

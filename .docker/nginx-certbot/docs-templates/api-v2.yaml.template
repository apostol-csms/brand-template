  /api/v2/versions:
    get:
      description: The versions the caller may see, filtered, sorted and paged. total counts the rows
        of the same selection before paging.
      operationId: versions_list
      parameters:
      - description: 'Conditions on the row''s properties: filter[<property>]=<value>, or filter[<property>][<operator>]=<value>
          with the operator one of eq, ne, lt, lte, gt, gte, like, ilike, in (comma-separated values),
          null. Conditions are joined with AND.'
        explode: true
        in: query
        name: filter
        schema:
          additionalProperties:
            oneOf:
            - type: string
            - additionalProperties:
                type: string
              type: object
          type: object
        style: deepObject
      - description: 'Comma-separated properties; a leading - is descending: sort=-created,name.'
        in: query
        name: sort
        schema:
          type: string
      - description: Comma-separated properties to return; the others are left out of each item.
        in: query
        name: fields
        schema:
          type: string
      - description: Page size.
        in: query
        name: page[limit]
        schema:
          default: 500
          maximum: 1000
          minimum: 1
          type: integer
      - description: Rows to skip.
        in: query
        name: page[offset]
        schema:
          default: 0
          minimum: 0
          type: integer
      - description: One term, matched without regard to case over code, name; given once.
        in: query
        name: q
        schema:
          type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                properties:
                  items:
                    items:
                      $ref: '#/components/schemas/Version'
                    type: array
                  limit:
                    description: Page size applied.
                    type: integer
                  offset:
                    description: Rows skipped.
                    type: integer
                  total:
                    description: Number of rows of the whole selection.
                    format: int64
                    type: integer
                required:
                - items
                - total
                - limit
                - offset
                type: object
          description: The page.
        '400':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: An unknown query parameter, or a bad filter, sort, fields or page value; q given
            more than once.
        '401':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No bearer token, a token that does not verify or has expired, or a session the
            database does not know. Carries WWW-Authenticate.
        '403':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'The database refused: the route is not open to this session, or a right is missing
            (ERR-403-…).'
        default:
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'Any other refusal of the error catalogue: the status is the GGG of its ERR-GGG-CCC
            code (400 where that is not a status). A failure of the service itself is 500 with type urn:apostol:error:internal.'
      summary: List versions
      tags:
      - versions
    post:
      description: 'One request is one transaction. The answer is the new row.


        Route guard: the gateway refuses this write to every session that is not an administrator (403),
        before the database; the routes that read are open to any session.'
      operationId: versions_create
      parameters:
      - description: 'Optional. The same key with the same body replays the stored answer (marked Idempotency-Replayed:
          true) for 24 hours; the same key with another body is 409. A key is scoped to the session and
          the path; a 5xx answer is not stored. The store is in the memory of one service process: a replay
          is not found after a restart, nor on another instance.'
        in: header
        name: Idempotency-Key
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VersionInput'
        required: true
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Version'
          description: Created.
          headers:
            ETag:
              description: 'Weak ETag of the row: its last update, or a digest of the row.'
              schema:
                type: string
            Location:
              description: Path of the new row.
              schema:
                type: string
        '400':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No body, an unknown key, a value of the wrong type, a required property missing,
            or a value the database refuses.
        '401':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No bearer token, a token that does not verify or has expired, or a session the
            database does not know. Carries WWW-Authenticate.
        '403':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'The database refused: the route is not open to this session, or a right is missing
            (ERR-403-…).'
        '409':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: Idempotency-Key reused with a different body, or the database reports a conflict.
        default:
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'Any other refusal of the error catalogue: the status is the GGG of its ERR-GGG-CCC
            code (400 where that is not a status). A failure of the service itself is 500 with type urn:apostol:error:internal.'
      summary: Create a version
      tags:
      - versions
  /api/v2/versions/{id}:
    get:
      operationId: versions_get
      parameters:
      - description: 'Identifier of the version: a UUID. Anything else is refused with 400 before the
          database.'
        in: path
        name: id
        required: true
        schema:
          format: uuid
          type: string
      - description: Comma-separated properties to return; the others are left out. The ETag is that of
          the whole row.
        in: query
        name: fields
        schema:
          type: string
      - description: 'The ETag of the copy the client holds: when it is current the answer is 304 with
          no body.'
        in: header
        name: If-None-Match
        schema:
          type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Version'
          description: The row.
          headers:
            ETag:
              description: 'Weak ETag of the row: its last update, or a digest of the row.'
              schema:
                type: string
        '304':
          description: The row has not changed since If-None-Match. No body.
          headers:
            ETag:
              description: 'Weak ETag of the row: its last update, or a digest of the row.'
              schema:
                type: string
        '400':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: The id is not a UUID, a bad fields value, or a query parameter other than fields.
        '401':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No bearer token, a token that does not verify or has expired, or a session the
            database does not know. Carries WWW-Authenticate.
        '403':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'The database refused: the route is not open to this session, or a right is missing
            (ERR-403-…).'
        '404':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: There is no such version, or the caller may not see it — the two are not told apart.
        default:
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'Any other refusal of the error catalogue: the status is the GGG of its ERR-GGG-CCC
            code (400 where that is not a status). A failure of the service itself is 500 with type urn:apostol:error:internal.'
      summary: Get a version
      tags:
      - versions
    patch:
      description: 'Only the given keys change. If-Match is required: the ETag of the revision the client
        read.


        Route guard: the gateway refuses this write to every session that is not an administrator (403),
        before the database; the routes that read are open to any session.'
      operationId: versions_update
      parameters:
      - description: 'Identifier of the version: a UUID. Anything else is refused with 400 before the
          database.'
        in: path
        name: id
        required: true
        schema:
          format: uuid
          type: string
      - description: The ETag of the row as read; * matches any current row. Without it the answer is
          428 and the body is not read.
        in: header
        name: If-Match
        required: true
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VersionPatch'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Version'
          description: The row after the change.
          headers:
            ETag:
              description: 'Weak ETag of the row: its last update, or a digest of the row.'
              schema:
                type: string
        '400':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: The id is not a UUID, the body is empty or has no key, an unknown key, a value
            of the wrong type or one the database refuses.
        '401':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No bearer token, a token that does not verify or has expired, or a session the
            database does not know. Carries WWW-Authenticate.
        '403':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'The database refused: the route is not open to this session, or a right is missing
            (ERR-403-…).'
        '404':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: There is no such version, or the caller may not see it — the two are not told apart.
        '412':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'The row changed since it was read: If-Match is no longer its ETag.'
        '428':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No If-Match header.
        default:
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'Any other refusal of the error catalogue: the status is the GGG of its ERR-GGG-CCC
            code (400 where that is not a status). A failure of the service itself is 500 with type urn:apostol:error:internal.'
      summary: Change a version
      tags:
      - versions
  /api/v2/versions/{id}/actions/{action}:
    post:
      description: 'Runs a method of the object''s workflow by the code of its action, on a row the caller
        may see. The methods available now are listed by GET …/methods. The answer is the row after the
        action; a row the action removed leaves none and the answer is 204.


        Route guard: the gateway refuses this write to every session that is not an administrator (403),
        before the database; the routes that read are open to any session.'
      operationId: versions_action
      parameters:
      - description: 'Identifier of the version: a UUID. Anything else is refused with 400 before the
          database.'
        in: path
        name: id
        required: true
        schema:
          format: uuid
          type: string
      - description: Code of the action (enable, disable, delete, drop, …).
        in: path
        name: action
        required: true
        schema:
          pattern: ^[a-z][a-z0-9_]{0,63}$
          type: string
      requestBody:
        content:
          application/json:
            schema:
              additionalProperties: true
              type: object
        description: Parameters of the action. Optional; a JSON object, at most 1 MiB.
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Version'
          description: The row after the action.
          headers:
            ETag:
              description: 'Weak ETag of the row: its last update, or a digest of the row.'
              schema:
                type: string
        '204':
          description: The action removed the row. No body.
        '400':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: The id is not a UUID, the action name is malformed, or the body is not a JSON object.
        '401':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: No bearer token, a token that does not verify or has expired, or a session the
            database does not know. Carries WWW-Authenticate.
        '403':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'The database refused: the route is not open to this session, or a right is missing
            (ERR-403-…).'
        '404':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: There is no such version, or the caller may not see it — the two are not told apart.
        '413':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: The body is over 1 MiB.
        default:
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'Any other refusal of the error catalogue: the status is the GGG of its ERR-GGG-CCC
            code (400 where that is not a status). A failure of the service itself is 500 with type urn:apostol:error:internal.'
      summary: Execute an action of the version
      tags:
      - versions

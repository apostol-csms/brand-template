        class:
          description: Class of the object.
          format: uuid
          type: string
        classcode:
          description: Code of the class.
          type: string
        classlabel:
          description: Label of the class in the session's locale, or null.
          type: string
          nullable: true
        code:
          description: 'Code of the reference: its business key, unique within the scope.'
          type: string
        created:
          description: Time of creation.
          format: date-time
          type: string
        description:
          description: Description of the row in the session's locale, or null.
          type: string
          nullable: true
        entity:
          description: Entity of the object.
          format: uuid
          type: string
        entitycode:
          description: Code of the entity.
          type: string
        entityname:
          description: Name of the entity in the session's locale, or null where it has no text.
          type: string
          nullable: true
        id:
          description: Identifier of the row (the reference's own; the object has the same id in object).
          format: uuid
          type: string
        label:
          description: Label of the object in the session's locale, or null.
          type: string
          nullable: true
        lastupdate:
          description: Time of the last update; the ETag is made of it.
          format: date-time
          type: string
        name:
          description: Name of the row in the session's locale, or null where it has no text.
          type: string
          nullable: true
        object:
          description: Identifier of the underlying object.
          format: uuid
          type: string
        oper:
          description: User that made the last operation.
          format: uuid
          type: string
        opercode:
          description: Login of that user.
          type: string
        operdate:
          description: Operating date of the last operation.
          format: date-time
          type: string
        opername:
          description: Name of that user.
          type: string
        owner:
          description: User that owns the object.
          format: uuid
          type: string
        ownercode:
          description: Login of the owner.
          type: string
        ownername:
          description: Name of the owner.
          type: string
        parent:
          description: Parent object, or null.
          format: uuid
          type: string
          nullable: true
        scope:
          description: Scope (the database's visibility boundary) the object lives in.
          format: uuid
          type: string
        scopecode:
          description: Code of the scope.
          type: string
        scopedescription:
          description: Description of the scope, or null.
          type: string
          nullable: true
        scopename:
          description: Name of the scope.
          type: string
        state:
          description: Current state of the workflow.
          format: uuid
          type: string
        statecode:
          description: Code of the current state.
          type: string
        statelabel:
          description: Label of the current state in the session's locale, or null.
          type: string
          nullable: true
        statetype:
          description: 'Type of the state: created, enabled, disabled, deleted.'
          format: uuid
          type: string
        statetypecode:
          description: Code of the state type.
          type: string
        statetypename:
          description: Name of the state type in the session's locale, or null.
          type: string
          nullable: true
        type:
          description: Type of the row.
          format: uuid
          type: string
        typecode:
          description: Code of the type, for example system.agent.
          type: string
        typedescription:
          description: Description of the type in the session's locale, or null.
          type: string
          nullable: true
        typename:
          description: Name of the type in the session's locale, or null.
          type: string
          nullable: true
        vendor:
          description: Vendor of the agent (api.vendor).
          format: uuid
          type: string
        vendorcode:
          description: Code of the vendor, or null.
          type: string
          nullable: true
        vendordescription:
          description: Description of the vendor in the session's locale, or null.
          type: string
          nullable: true
        vendorname:
          description: Name of the vendor in the session's locale, or null.
          type: string
          nullable: true

    AgentInput:
      additionalProperties: false
      description: 'Body of POST /api/v2/agents. An absent key and an explicit null both mean "not set",
        except for a required key: it must be present and not empty (400 otherwise); a key the schema
        does not name is refused with 400.'
      properties:
        code:
          description: 'Code of the agent: its business key. Required on create; on PATCH it may be absent
            (kept) but not emptied.'
          minLength: 1
          type: string
        description:
          description: Description of the agent in the session's locale.
          type: string
          nullable: true
        name:
          description: Name of the agent in the session's locale.
          type: string
          nullable: true
        parent:
          description: Parent object (UUID), or absent.
          format: uuid
          type: string
          nullable: true
        type:
          description: Type of the agent (UUID of a type of the agent entity). On create the type system.agent
            is used when absent; on PATCH absent keeps the type.
          format: uuid
          type: string
          nullable: true
        vendor:
          description: Vendor of the agent (UUID of a vendor). Required on create; on PATCH absent keeps
            it.
          format: uuid
          minLength: 1
          type: string
      required:
      - vendor
      - code
      type: object
    AgentPatch:
      additionalProperties: false
      description: Body of PATCH /api/v2/agents/{id}. An absent key and an explicit null both mean "do
        not change"; at least one key with a value (not null) is required; a key the schema does not name
        is refused with 400.
      minProperties: 1
      properties:
        code:
          description: 'Code of the agent: its business key. Required on create; on PATCH it may be absent
            (kept) but not emptied.'
          type: string
          nullable: true
        description:
          description: Description of the agent in the session's locale.
          type: string
          nullable: true
        name:
          description: Name of the agent in the session's locale.
          type: string
          nullable: true
        parent:
          description: Parent object (UUID), or absent.
          format: uuid
          type: string
          nullable: true
        type:
          description: Type of the agent (UUID of a type of the agent entity). On create the type system.agent
            is used when absent; on PATCH absent keeps the type.
          format: uuid
          type: string
          nullable: true
        vendor:
          description: Vendor of the agent (UUID of a vendor). Required on create; on PATCH absent keeps
            it.
          format: uuid
          type: string
          nullable: true
      type: object

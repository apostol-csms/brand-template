        style: deepObject
      - description: 'Comma-separated properties; a leading - is descending: sort=-created,name.'
        in: query
        name: sort
        schema:
          type: string
      - description: Comma-separated properties to return; the others are left out of each item.
        in: query
        name: fields
        schema:
          type: string
      - description: Page size.
        in: query
        name: page[limit]
        schema:
          default: 500
          maximum: 1000
          minimum: 1

          description: 'The database refused: the route is not open to this session, or a right is missing
            (ERR-403-…).'
        '404':
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: There is no such vendor, or the caller may not see it — the two are not told apart.
        default:
          content:
            application/problem+json:
              schema:
                $ref: '#/components/schemas/Problem'
          description: 'Any other refusal of the error catalogue: the status is the GGG of its ERR-GGG-CCC
            code (400 where that is not a status). A failure of the service itself is 500 with type urn:apostol:error:internal.'
      summary: Methods of the vendor now

# ─── cs.${DOMAIN} ──────────────────────────────────────────────────────
# CS Web UI Pro — frontend + backend API + CS REST API proxy to OCPP service

server {
    listen 443 ssl;

    server_name cs.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/cs.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cs.${DOMAIN}/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    ssl_stapling off;

    client_max_body_size 10m;

    # CS REST API — proxy to OCPP Central System
    location ^~ /cs-api/ {
        rewrite ^/cs-api/(.*) /api/v1/$1 break;
        proxy_pass $ocpp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "keep-alive";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # CS WebSocket log — proxy to OCPP Central System
    location ^~ /cs-ws/ {
        rewrite ^/cs-ws/(.*) /ws/$1 break;
        proxy_pass $ocpp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
    }

    # All other locations — same as other app subdomains
    include /etc/nginx/includes/proxy-backend.conf;
}

# ─── ocpp.${DOMAIN} ────────────────────────────────────────────────────
# OCPP Central System (WebSocket + REST API)

server {
    listen 443 ssl;

    server_name ocpp.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/ocpp.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ocpp.${DOMAIN}/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    ssl_stapling off;

    access_log /var/log/nginx/ocpp_access.log;
    error_log  /var/log/nginx/ocpp_error.log;

    client_max_body_size       10m;
    client_body_buffer_size    128k;
    proxy_connect_timeout      70;
    proxy_send_timeout         90;
    proxy_read_timeout         90;
    proxy_buffering            on;
    proxy_buffer_size          4k;
    proxy_buffers              4 32k;
    proxy_busy_buffers_size    64k;
    proxy_temp_file_write_size 64k;

    location ^~ /ocpp/ {
        proxy_pass $ocpp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass $ocpp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "keep-alive";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# ─── auth.${DOMAIN} ────────────────────────────────────────────────────
# OAuth2 Auth App (standalone Vue SPA)

server {
    listen 443 ssl;

    server_name auth.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/auth.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.${DOMAIN}/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    ssl_stapling off;

    client_max_body_size 1m;

    location = /oauth2/token {
        limit_req zone=auth_token burst=5 nodelay;
        limit_req_status 429;

        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin "https://$host";
        proxy_set_header Connection "keep-alive";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /oauth2/identifier {
        limit_req zone=auth_identifier burst=5 nodelay;
        limit_req_status 429;

        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin "https://$host";
        proxy_set_header Connection "keep-alive";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ^~ /oauth2/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin "https://$host";
        proxy_set_header Connection "keep-alive";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ^~ /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin "https://$host";
        proxy_set_header Connection "keep-alive";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass $auth_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}

# ─── ${DOMAIN} ─────────────────────────────────────────────────

server {
    listen 443 ssl;

    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    ssl_stapling off;

    # Landing-conditional: with no landing service in compose, the
    # variable-based proxy_pass to $landing_upstream fails to resolve and
    # nginx answers 502/503/504. Intercept that and redirect to the cloud
    # SPA, so the bare DOMAIN is always alive.
    #
    # For a brand with no landing site of its own (service commented out
    # in compose) this fallback IS the normal path. But resolving a
    # non-existent upstream costs one failed DNS lookup on EVERY request
    # to the apex — if a landing site is never coming, replace the whole
    # `location /` with a plain
    # `return 301 https://cloud.${DOMAIN}$request_uri;` instead.
    location / {
        proxy_pass $landing_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "keep-alive";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_intercept_errors on;
        error_page 502 503 504 = @no_landing;
    }

    location @no_landing {
        return 301 https://cloud.${DOMAIN}$request_uri;
    }
}

# ─── ws.${DOMAIN} ─────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;

    server_name ws.${DOMAIN};

    access_log  /var/log/nginx/ws_access.log;
    error_log   /var/log/nginx/ws_error.log;

    # This block owns :80 for ws.${DOMAIN} (plain ws:// for OCPP stations
    # that don't support TLS), so unlike the other subdomains it does NOT
    # fall through to the shared ACME :80 server above — that block's
    # server_name list doesn't include ws.${DOMAIN}, and nginx routes by
    # exact server_name match. Without this location, certbot's HTTP-01
    # webroot challenge hits `location /` below and gets proxied to the
    # backend instead of served from disk — renewal fails every time,
    # eventually triggering Let's Encrypt's failed-authorization rate limit.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
        default_type "text/plain";
    }

    ssl_certificate /etc/letsencrypt/live/ws.${DOMAIN}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ws.${DOMAIN}/privkey.pem; # managed by Certbot

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    ssl_stapling off;

    client_max_body_size       10m;
    client_body_buffer_size    128k;

    client_body_temp_path      /var/nginx/client_body_temp;

    proxy_connect_timeout      70;
    proxy_send_timeout         90;
    proxy_read_timeout         90;

    proxy_buffering            on;
    proxy_buffer_size          4k;
    proxy_buffers              4 32k;
    proxy_busy_buffers_size    64k;
    proxy_temp_file_write_size 64k;

    proxy_temp_path            /var/nginx/proxy_temp;

    location ^~ /session/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    location ^~ /ocpp/ {
        proxy_pass $ocpp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

}

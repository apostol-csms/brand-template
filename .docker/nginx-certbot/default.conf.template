# nginx config — HTTPS with Let's Encrypt SSL
#
# Routing:
#   cloud/cpo/driver/admin.${DOMAIN}     → frontend (Nuxt SPA) + backend API
#   cs.${DOMAIN}                         → frontend + backend API + CS REST API (/cs-api/*, /cs-ws/*)
#   auth.${DOMAIN}                       → auth container + backend API
#   ocpp.${DOMAIN}                       → OCPP Central System

# Rate limiting zones defined in nginx.conf (auth_token, auth_identifier)

# Upstreams are resolved lazily via resolver 127.0.0.11 + map $host $*_upstream
# (see nginx.conf). No static upstream{} blocks — they pin the IP at start and
# break on container restart.

# ─── HTTP → HTTPS redirect (ACME-safe) ──────────────────────────────────────
#
# Single :80 server. ACME challenge is served as plain HTTP via
# /.well-known/acme-challenge/, all other traffic 301'd to HTTPS via
# `location /` (NOT `if ($host = …) { return 301 …; }`, which executes in
# the rewrite phase ahead of location matching and would intercept ACME
# requests — breaking renewal at the worst possible moment, when the
# cert just expired and HTTPS validation is no longer trusted).
#
# Source pattern: Let's Encrypt community FAQ + certbot upstream docs +
# nginx-proxy/acme-companion (production reference).

server {
    listen 80;
    listen [::]:80;

    server_name
        ${DOMAIN}
        www.${DOMAIN}
        admin.${DOMAIN}
        api.${DOMAIN}
        auth.${DOMAIN}
        cloud.${DOMAIN}
        cpo.${DOMAIN}
        cs.${DOMAIN}
        driver.${DOMAIN}
        ocpp.${DOMAIN}
        pay.${DOMAIN};

    server_tokens off;

    # ^~ locks priority above any `/` block and above the rewrite phase.
    # Without ^~ the prefix match is still preferred over `location /`,
    # but ^~ makes the intent explicit and skips regex location scanning.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─── SSL defaults ────────────────────────────────────────────────────────────

# Shared SSL settings (each server block references own cert)
# include /etc/letsencrypt/options-ssl-nginx.conf + ssl_dhparam in each block

# ─── cloud.${DOMAIN} ───────────────────────────────────────────────────

server {
    listen 443 ssl;

    server_name cloud.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/cloud.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cloud.${DOMAIN}/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    ssl_stapling off;

    client_max_body_size 10m;

    include /etc/nginx/includes/proxy-backend.conf;
}

# ─── pay.${DOMAIN} ───────────────────────────────────────────────────
# Ad-hoc QR payment entry point (AFIR compliance).
# Public, no auth. Only /charge/* routes to backend PGHTTP.
# Everything else → minimal landing page or redirect.

server {
    listen 443 ssl;

    server_name pay.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/pay.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pay.${DOMAIN}/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    ssl_stapling off;

    # REST API → backend (currently /api/v1/manifest for the attestation
    # bootstrap; future hooks like cookie-auth would land here too).
    location ^~ /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # /charge/info/{uuid} → backend PGHTTP (GET connector info, called by frontend JS)
    location ^~ /charge/info/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        limit_req zone=charge_status burst=30 nodelay;
        limit_req_status 429;
    }

    # /charge/create/{uuid} → backend PGHTTP (POST create payment)
    location ^~ /charge/create/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        limit_req zone=charge_create burst=20 nodelay;
        limit_req_status 429;
    }

    # /charge/status/{id} → backend PGHTTP (polling for session status)
    location ^~ /charge/status/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        limit_req zone=charge_status burst=60 nodelay;
        limit_req_status 429;
    }

    # /charge/stop/{id} → backend PGHTTP (stop charging, requires Bearer)
    location ^~ /charge/stop/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        limit_req zone=charge_create burst=20 nodelay;
        limit_req_status 429;
    }

    # /charge/cancel/{id} → backend PGHTTP (cancel a not-yet-completed
    # payment, requires the charge_secret; driver backing out of checkout)
    location ^~ /charge/cancel/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        limit_req zone=charge_create burst=20 nodelay;
        limit_req_status 429;
    }

    # /oauth2/token → backend AuthServer (service auth for WebSocket)
    location ^~ /oauth2/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        limit_req zone=charge_create burst=3 nodelay;
        limit_req_status 429;
    }

    # Stripe webhook → backend PGHTTP (preserves raw body + Stripe-Signature header)
    location = /stripe/webhook {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Frontend pages (Nuxt pay app)
    location / {
        proxy_pass $pay_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}


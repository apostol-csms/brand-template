          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "outcome"
        ],
        "title": "Response",
        "type": "object"
      },
      "Role": {
        "enum": [

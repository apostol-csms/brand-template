  "info": {
    "description": "payment-test: a stand-in payment provider behind the payment-service contract.\n\nRoutes:\n  POST /v1/{pay,capture,cancel,refund,status,bind,unbind}  the operations\n  POST /test/renotify/{provider_id}                       send the last event again\n  GET  /health, /docs, /openapi.json                      no key needed\n\nEvery /v1 and /test route requires X-Service-Key equal to SERVICE_KEY (401\notherwise). An answer is HTTP 200 with the response envelope; a repeat with\nthe same idempotency_key gets the first answer, whatever its body.\n",
    "title": "payment-test",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/test/renotify/{provider_id}": {
      "post": {
        "operationId": "renotify_test_renotify__provider_id__post",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "title": "Provider Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-service-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Renotify Test Renotify  Provider Id  Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "missing or wrong X-Service-Key"
          },
          "404": {
            "description": "no event for this provider_id"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "send the last event of a payment again"
      }
    },
